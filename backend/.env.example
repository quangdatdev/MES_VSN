# --- SQL Server (máy dev) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
# Database lõi và database module Đơn hàng (mặc định MES_Core, MES_Order)
DB_CORE_NAME=MES_Core
DB_ORDER_NAME=MES_Order
# Module May: Kế hoạch chuẩn bị SX (mặc định MES_Sewing; quản trị CSDL tạo trước, cấp db_owner cho tài khoản ứng dụng)
DB_SEWING_NAME=MES_Sewing
# Module Nhân sự: sơ đồ tổ chức, hồ sơ nhân viên (mặc định MES_Hr; quản trị CSDL tạo trước, cấp db_owner cho tài khoản ứng dụng)
DB_HR_NAME=MES_Hr
# Bảng chép dữ liệu đồng bộ và nhật ký đồng bộ (mặc định MES_Sync; quản trị CSDL tạo trước, xem docs/thiet-ke/db-sync.md)
DB_SYNC_NAME=MES_Sync
# Database trung gian chứa view của BRAVO (cùng máy SQL Server). MES chỉ đọc view ở đây, không đọc thẳng BRAVO.
DB_TRUNGGIAN_NAME=

# --- Ứng dụng ---
PORT=3000
JWT_SECRET=
# Mật khẩu chung cho các tài khoản demo (chỉ dùng cho dữ liệu giả)
DEMO_PASSWORD=
# Seed có nạp dữ liệu mẫu (đơn hàng giả, phòng ban và nhân viên giả) không: true/false. Để trống: true, riêng NODE_ENV=production là false.
# false thì reset:demo, load:bravo, sim:board từ chối chạy
SEED_SAMPLE_DATA=
# Cookie phiên chỉ qua HTTPS (mặc định bật khi NODE_ENV=production). Demo HTTP trong mạng nội bộ: false
COOKIE_SECURE=false
# Chỉ đặt khi chạy sau reverse proxy (vd: loopback hoặc IP Nginx). Để trống: không tin X-Forwarded-For
TRUST_PROXY=
# Địa chỉ lắng nghe. Demo trong LAN: 0.0.0.0 (mặc định). Sau Nginx cùng máy: 127.0.0.1
HOST=
