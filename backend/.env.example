# --- SQL Server (máy dev) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
# Mã hóa kết nối tới SQL Server: chỉ true (chữ thường) mới bật. Để trống: tắt; giá trị khác cũng là tắt, không báo lỗi
DB_ENCRYPT=
# Tin chứng chỉ của SQL Server (bật là không kiểm chứng chỉ, nhận chứng chỉ tự ký): chỉ false (chữ thường) mới tắt. Để trống: bật
DB_TRUST_CERT=
# Database lõi và database module Đơn hàng (mặc định MES_Core, MES_Order)
DB_CORE_NAME=MES_Core
DB_ORDER_NAME=MES_Order
# Module May: Kế hoạch chuẩn bị SX (mặc định MES_Sewing; quản trị CSDL tạo trước, cấp db_owner cho tài khoản ứng dụng)
DB_SEWING_NAME=MES_Sewing
# Module Cắt: Đồng bộ tiến độ cắt (mặc định MES_Cutting; tài khoản không có quyền CREATE DATABASE thì quản trị CSDL tạo trước, cấp db_owner)
DB_CUTTING_NAME=MES_Cutting
# Module Nhân sự: sơ đồ tổ chức, hồ sơ nhân viên (mặc định MES_Hr; quản trị CSDL tạo trước, cấp db_owner cho tài khoản ứng dụng)
DB_HR_NAME=MES_Hr
# Bảng chép dữ liệu đồng bộ và nhật ký đồng bộ (mặc định MES_Sync; quản trị CSDL tạo trước, xem docs/thiet-ke/db-sync.md)
DB_SYNC_NAME=MES_Sync
# Database trung gian chứa view của BRAVO (cùng máy SQL Server, hoặc máy khác qua DB_TRUNGGIAN_SERVER). MES chỉ đọc view ở đây, không đọc thẳng BRAVO.
DB_TRUNGGIAN_NAME=
# Database trung gian ở SQL Server khác: tên linked server tới máy đó (vd LS_BRAVO), migrate tạo synonym [LS_BRAVO].[BRAVO_TRE].[dbo].[view].
# Cùng máy SQL Server thì để trống
DB_TRUNGGIAN_SERVER=
# Database OSM chứa view vOSMDataFty (nhà máy sản xuất của đơn hàng), chép vào MES_Sync.osm. Để trống: bỏ qua nguồn OSM
DB_OSM_NAME=
# Database OSM ở SQL Server khác: tên linked server. Cùng máy thì để trống
DB_OSM_SERVER=
# Database ứng dụng OSM chứa view v_OSMData (phân bổ PO theo nhà máy, màn Phân bổ PO), chép vào MES_Sync.osm. Để trống: tắt nguồn này
DB_OSM_APP_NAME=
# Database ứng dụng OSM ở SQL Server khác: tên linked server (vd DB_OSM_TRE). Cùng máy thì để trống
DB_OSM_APP_SERVER=

# --- Ứng dụng ---
# Máy chủ dùng thật: bỏ dấu # ở dòng NODE_ENV dưới (bắt buộc JWT_SECRET ít nhất 32 ký tự, DEMO_PASSWORD ít nhất 8 ký tự; COOKIE_SECURE
# để trống thì bật, file này đặt false cho HTTP; SEED_SAMPLE_DATA để trống thì false). Để dạng comment để chép thêm khối này xuống cuối
# .env không đè dòng NODE_ENV đã có (dòng sau đè dòng trước). Chỉ đặt ở file .env, không đặt thành biến môi trường của Windows:
# khi đó npm ci bỏ devDependencies nên build, migrate hỏng. Máy dev, demo: giữ dấu #
# NODE_ENV=production
PORT=3000
JWT_SECRET=
# Thời hạn access token, token tạm (giữa bước mật khẩu và bước chọn ĐVCS), tính bằng giây. Để trống: 900, 300
JWT_ACCESS_TTL=
PRE_AUTH_TTL=
# Thời hạn phiên và cookie refresh, tính bằng ngày. Để trống: 7
REFRESH_TTL_DAYS=
# Sai mật khẩu liên tiếp bao nhiêu lần thì khóa tạm, khóa bao nhiêu phút. Để trống: 5, 15
LOGIN_MAX_FAILED=
LOGIN_LOCK_MINUTES=
# Mật khẩu ban đầu của tài khoản admin (npm run migrate tạo) và các tài khoản demo (npm run seed); ít nhất 8 ký tự khi production.
# Không ai tự đổi được mật khẩu của mình: xem README mục Cài đặt lần đầu để đổi mật khẩu admin
DEMO_PASSWORD=
# npm run seed có nạp dữ liệu mẫu (tài khoản demo, đơn hàng giả, phòng ban và nhân viên giả) không: true/false. Để trống: true, riêng NODE_ENV=production là false.
# false thì reset:demo, load:bravo, sim:board từ chối chạy
SEED_SAMPLE_DATA=
# Backend tự nạp đơn hàng BRAVO (đã chép ở MES_Sync) vào MES_Order sau mỗi đợt đồng bộ và lúc khởi động: true/false.
# Để trống: bật khi không dùng dữ liệu mẫu (máy dùng thật), tắt trên máy demo, máy test (máy demo dùng npm run load:bravo)
BRAVO_ORDER_IMPORT=
# Cập nhật Nhà máy SX của đơn hàng theo OSM sau mỗi đợt đồng bộ OSM và lúc khởi động: true/false. Để trống: bật
OSM_FACTORY_UPDATE=
# Làm mới bảng Phân bổ PO (MES_Order.PoAllocation) từ dữ liệu OSM đã chép sau mỗi đợt đồng bộ nguồn OSM.OSMData và lúc khởi
# động, giữ Nhà máy SX nhập tay: true/false. Để trống: bật. Tắt thì màn Phân bổ PO không nhận dữ liệu OSM mới
PO_ALLOCATION_REFRESH=
# Làm mới Phân bổ PO: nguồn OSM ít hơn bao nhiêu % so với số dòng đang có thì không xóa dòng vắng (vẫn thêm, sửa; màn cảnh báo).
# Số nguyên 0-100, để trống: 20. Đặt 100 rồi khởi động lại backend khi OSM thật sự bớt nhiều PO
PO_ALLOCATION_MAX_SHRINK_PERCENT=
# Cookie phiên chỉ qua HTTPS (mặc định bật khi NODE_ENV=production). Demo HTTP trong mạng nội bộ: false
COOKIE_SECURE=false
# Chỉ đặt khi chạy sau reverse proxy (vd: loopback hoặc IP Nginx). Để trống: không tin X-Forwarded-For
TRUST_PROXY=
# Địa chỉ lắng nghe. Demo trong LAN: 0.0.0.0 (mặc định). Sau Nginx cùng máy: 127.0.0.1
HOST=
